<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TinySolitaire.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TableBrush" Color="#E7EFE8" />
                    <SolidColorBrush x:Key="TableTextBrush" Color="#244D3D" />
                    <SolidColorBrush x:Key="TableMutedBrush" Color="#4D6B5B" />
                    <SolidColorBrush x:Key="SlotBrush" Color="#DCE7DD" />
                    <SolidColorBrush x:Key="SlotStrokeBrush" Color="#A4B9AA" />
                    <SolidColorBrush x:Key="CardFaceBrush" Color="#FFFEF7" />
                    <SolidColorBrush x:Key="CardInkBrush" Color="#1F382E" />
                    <SolidColorBrush x:Key="CardRedBrush" Color="#AD2449" />
                    <SolidColorBrush x:Key="CardEdgeBrush" Color="#B6C7B9" />
                    <SolidColorBrush x:Key="CardBackBrush" Color="#D5E7D8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TableBrush" Color="#17392F" />
                    <SolidColorBrush x:Key="TableTextBrush" Color="#E2EEE5" />
                    <SolidColorBrush x:Key="TableMutedBrush" Color="#AEC9BA" />
                    <SolidColorBrush x:Key="SlotBrush" Color="#204337" />
                    <SolidColorBrush x:Key="SlotStrokeBrush" Color="#547765" />
                    <SolidColorBrush x:Key="CardFaceBrush" Color="#F4F3E9" />
                    <SolidColorBrush x:Key="CardInkBrush" Color="#1F382E" />
                    <SolidColorBrush x:Key="CardRedBrush" Color="#AD2449" />
                    <SolidColorBrush x:Key="CardEdgeBrush" Color="#849E8B" />
                    <SolidColorBrush x:Key="CardBackBrush" Color="#315C47" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TableBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TableTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TableMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SlotBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SlotStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CardFaceBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="CardInkBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="CardRedBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="CardEdgeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="CardBackBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="VictoryPrimaryColor">#FFFFD166</Color>
            <Color x:Key="VictorySecondaryColor">#FFFF6B9D</Color>
            <Color x:Key="VictoryAccentColor">#FF54DFF5</Color>
            <Color x:Key="VictoryHighlightColor">#FFF4F3E9</Color>

            <Style x:Key="PlayingCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="72" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="{ThemeResource CardFaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource CardInkBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardEdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="SelectedCardButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayingCardButtonStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style x:Key="SlotButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayingCardButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SlotBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SlotStrokeBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TableMutedBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="CardBackStyle" TargetType="Border">
                <Setter Property="Width" Value="48" />
                <Setter Property="Height" Value="72" />
                <Setter Property="Background" Value="{ThemeResource CardBackBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardEdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="3" />
            </Style>
            <Style x:Key="PlayingCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBackStyle}">
                <Setter Property="Background" Value="{ThemeResource CardFaceBrush}" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="CardInkStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource CardInkBrush}" />
                <Setter Property="FontFamily" Value="Georgia" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CardFaceGridStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardFaceBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="CardRedStyle" TargetType="TextBlock" BasedOn="{StaticResource CardInkStyle}">
                <Setter Property="Foreground" Value="{ThemeResource CardRedBrush}" />
            </Style>
            <Style
                x:Key="FlyoutIconButtonStyle"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
