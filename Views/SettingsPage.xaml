<Page
    x:Class="TinySolitaire.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="16,14,16,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="BackButton" AutomationProperties.AutomationId="BackToGame" AutomationProperties.Name="Back to game"
                Style="{StaticResource FlyoutIconButtonStyle}" ToolTipService.ToolTip="Back to game (Esc)" Click="Back_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock Text="Make it yours" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="0,0,4,0">
                <InfoBar x:Name="SettingsError" Severity="Warning" IsOpen="False" IsClosable="False" />
                <StackPanel Spacing="5">
                    <ComboBox x:Name="DrawChoice" Header="Draw count" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="DrawChoice" AutomationProperties.Name="Draw count"
                        SelectionChanged="Draw_Changed">
                        <x:String>Draw one</x:String>
                        <x:String>Draw three</x:String>
                    </ComboBox>
                    <TextBlock Text="For your next new game. Your current deal stays intact." FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="10">
                    <ComboBox x:Name="CardChoice" Header="Card backs" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CardChoice" AutomationProperties.Name="Card back pattern"
                        SelectionChanged="Card_Changed" />
                    <StackPanel x:Name="CardPreview" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                        AutomationProperties.Name="Card back preview" />
                </StackPanel>
                <ComboBox x:Name="ThemeChoice" Header="Appearance" HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="ThemeChoice" AutomationProperties.Name="Appearance"
                    SelectionChanged="Theme_Changed">
                    <x:String>System</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                    <x:String>Green</x:String>
                </ComboBox>
                <StackPanel x:Name="StartupPanel" Spacing="4">
                    <ToggleSwitch x:Name="StartupToggle" Header="Start with Windows"
                        AutomationProperties.AutomationId="StartupToggle" AutomationProperties.Name="Start with Windows"
                        Toggled="Startup_Toggled" />
                    <TextBlock x:Name="StartupDescription" FontSize="12" TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="Tiny Solitaire 1.0 &#xB7; Just you and the cards.&#xA;Offline, no accounts. Your deal saves on this device."
                    FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
